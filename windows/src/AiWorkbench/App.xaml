<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AiWorkbench.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 中文字体（兼容 Win10/11） -->
            <FontFamily x:Key="ContentFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
