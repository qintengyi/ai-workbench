<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AiWorkbench.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AiWorkbench.Pages"
    xmlns:models="using:AiWorkbench.Models">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：provider / 模型 / 思考强度 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="0,0,0,8">
            <ComboBox x:Name="ProviderCombo" Header="Provider" Width="220" SelectionChanged="Provider_Changed"/>
            <ComboBox x:Name="ModelCombo" Header="Model" Width="220" IsEditable="True"/>
            <ComboBox x:Name="EffortCombo" Header="思考强度" Width="140">
                <x:String>off</x:String>
                <x:String>low</x:String>
                <x:String>medium</x:String>
                <x:String>high</x:String>
                <x:String>xhigh</x:String>
            </ComboBox>
            <ToggleSwitch x:Name="StreamToggle" Header="流式" IsOn="True" OffContent="否" OnContent="是"/>
        </StackPanel>

        <!-- 消息列表 -->
        <ListView x:Name="MsgList" Grid.Row="1" ItemsSource="{x:Bind Messages, Mode=OneWay}" Padding="0,8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Message">
                    <Border Padding="12,8" BorderThickness="0" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Margin="0,4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Role}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <Border Visibility="{x:Bind HasReasoning, Mode=OneWay}"
                                    Padding="8,4" CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="思考链" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{x:Bind ReasoningContent}" TextWrapping="Wrap" FontSize="11" Opacity="0.85"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Visibility="{x:Bind HasAuxTrace, Mode=OneWay}"
                                       Text="[图片已识别 — 辅助模型介入]" FontSize="11"
                                       Foreground="{ThemeResource SystemAccentColor}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 输入区 -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Padding="0,8,0,0">
            <TextBox x:Name="InputBox" Grid.Row="0"
                     PlaceholderText="输入消息，支持拖入图片或 Ctrl+V 粘贴图片…"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="200"
                     KeyDown="Input_KeyDown"
                     DragOver="Input_DragOver" Drop="Input_Drop"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="AttachBtn" Content="附加图片" Click="Attach_Click"/>
                <TextBlock x:Name="ImgCount" VerticalAlignment="Center" Opacity="0.7"/>
                <Button x:Name="SendBtn" Content="发送" Style="{ThemeResource AccentButtonStyle}" Click="Send_Click"/>
                <Button x:Name="CancelBtn" Content="取消" IsEnabled="False" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
