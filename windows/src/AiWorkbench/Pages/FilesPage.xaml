<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AiWorkbench.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AiWorkbench.Pages"
    xmlns:svc="using:AiWorkbench.Services">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="0,0,0,8">
            <Button x:Name="UpBtn" Content="↑ 上级" Click="Up_Click"/>
            <Button x:Name="RootBtn" Content="回到 E:\code" Click="Root_Click"/>
            <TextBlock x:Name="PathLabel" VerticalAlignment="Center" Opacity="0.8"/>
        </StackPanel>
        <SplitView Grid.Row="1" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="360" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <ListView x:Name="FileList" SelectionChanged="File_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:FileEntry">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind DirGlyph, Mode=OneTime}" FontSize="14"/>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </SplitView.Pane>
            <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="FileTitle" Grid.Row="0" FontWeight="SemiBold" Padding="8,0,0,4"/>
                <ScrollViewer Grid.Row="1" Padding="8,0,0,0">
                    <TextBlock x:Name="FileContent" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Grid>
        </SplitView>
    </Grid>
</Page>
